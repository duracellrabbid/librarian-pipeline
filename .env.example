# ==============================================================================
# Application Configuration
# ==============================================================================
APP_NAME=rag-ingestion-pipeline
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
MAX_BATCH_INGEST_SIZE=10
ALLOWED_DOMAINS='["https://en.wikipedia.org"]'

# ==============================================================================
# PostgreSQL 16 (Document Registry & Job Tracking)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_pipeline
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_pipeline
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_pipeline

# ==============================================================================
# Redis 7 (ARQ Message Broker & Caching)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
ARQ_JOB_TIMEOUT=900

# ==============================================================================
# Qdrant Vector Database
# ==============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ==============================================================================
# Ollama (Local Embeddings & LLM Service)
# ==============================================================================
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT=120.0

# ==============================================================================
# Scraper & Rate Limiting (Crawl4AI & Politeness)
# ==============================================================================
SCRAPER_MAX_RETRIES=3
SCRAPER_BACKOFF_FACTOR=1.5
SCRAPER_MAX_RETRY_DELAY=60.0
SCRAPER_MAX_CONCURRENCY_PER_DOMAIN=2
SCRAPER_PAGE_TIMEOUT=30.0
SCRAPER_USER_AGENT="RAG-Ingestion-Pipeline/0.1.0 (+https://github.com/duracellrabbid/librarian-pipeline; bot@example.com)"

