# ==============================================================================
# Application Configuration
# ==============================================================================
APP_NAME=rag-ingestion-pipeline
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# ==============================================================================
# PostgreSQL 16 (Document Registry & Job Tracking)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_pipeline
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_pipeline
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_pipeline

# ==============================================================================
# Redis 7 (ARQ Message Broker & Caching)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# Qdrant Vector Database
# ==============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ==============================================================================
# Ollama (Local Embeddings & LLM Service)
# ==============================================================================
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
